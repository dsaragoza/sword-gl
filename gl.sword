// Idiomatic OpenGL to Sword function calls definitions

func (c *Context) ActiveShaderProgram(pipeline u32, program u32) void {
    if command := c.glActiveShaderProgram {
        fn := extern func(u32, u32) void(command)
        fn(pipeline, program)
    }
    
}
        
func (c *Context) ActiveTexture(texture u32) void {
    if command := c.glActiveTexture {
        fn := extern func(u32) void(command)
        fn(texture)
    }
    
}
        
func (c *Context) AttachShader(program u32, shader u32) void {
    if command := c.glAttachShader {
        fn := extern func(u32, u32) void(command)
        fn(program, shader)
    }
    
}
        
func (c *Context) BeginConditionalRender(id u32, mode u32) void {
    if command := c.glBeginConditionalRender {
        fn := extern func(u32, u32) void(command)
        fn(id, mode)
    }
    
}
        
func (c *Context) BeginQuery(target u32, id u32) void {
    if command := c.glBeginQuery {
        fn := extern func(u32, u32) void(command)
        fn(target, id)
    }
    
}
        
func (c *Context) BeginQueryIndexed(target u32, index u32, id u32) void {
    if command := c.glBeginQueryIndexed {
        fn := extern func(u32, u32, u32) void(command)
        fn(target, index, id)
    }
    
}
        
func (c *Context) BeginTransformFeedback(primitiveMode u32) void {
    if command := c.glBeginTransformFeedback {
        fn := extern func(u32) void(command)
        fn(primitiveMode)
    }
    
}
        
func (c *Context) BindAttribLocation(program u32, index u32, name ?[*]u8) void {
    if command := c.glBindAttribLocation {
        fn := extern func(u32, u32, ?[*]u8) void(command)
        fn(program, index, name)
    }
    
}
        
func (c *Context) BindBuffer(target u32, buffer u32) void {
    if command := c.glBindBuffer {
        fn := extern func(u32, u32) void(command)
        fn(target, buffer)
    }
    
}
        
func (c *Context) BindBufferBase(target u32, index u32, buffer u32) void {
    if command := c.glBindBufferBase {
        fn := extern func(u32, u32, u32) void(command)
        fn(target, index, buffer)
    }
    
}
        
func (c *Context) BindBufferRange(target u32, index u32, buffer u32, offset i64, size i64) void {
    if command := c.glBindBufferRange {
        fn := extern func(u32, u32, u32, i64, i64) void(command)
        fn(target, index, buffer, offset, size)
    }
    
}
        
func (c *Context) BindFragDataLocation(program u32, color u32, name ?[*]u8) void {
    if command := c.glBindFragDataLocation {
        fn := extern func(u32, u32, ?[*]u8) void(command)
        fn(program, color, name)
    }
    
}
        
func (c *Context) BindFragDataLocationIndexed(program u32, colorNumber u32, index u32, name ?[*]u8) void {
    if command := c.glBindFragDataLocationIndexed {
        fn := extern func(u32, u32, u32, ?[*]u8) void(command)
        fn(program, colorNumber, index, name)
    }
    
}
        
func (c *Context) BindFramebuffer(target u32, framebuffer u32) void {
    if command := c.glBindFramebuffer {
        fn := extern func(u32, u32) void(command)
